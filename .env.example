# Optional. Waylo runs end-to-end in seeded mode without this value.
# Add the key only to your ignored .env.local file or deployment secret store.
OPENAI_API_KEY=

# Keep the public demo seeded-first unless the deployment is intentionally
# configured for protected live model calls.
WAYLO_DEMO_MODE=seeded

# Required only for a future protected live-demo deployment. A key alone does
# not enable live requests. Use independent, high-entropy server-side values.
WAYLO_LIVE_DEMO_SIGNING_SECRET=
WAYLO_LIVE_DEMO_ACCESS_CODE=
