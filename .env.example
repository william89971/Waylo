# Clerk authentication (passwordless email and Google are configured in Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Neon Postgres. Application traffic uses the pooled URL; migrations use the
# direct/unpooled URL. Never expose either variable to the browser.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Public origin for the current environment, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated Clerk user IDs allowed to access internal operations pages.
WAYLO_ADMIN_USER_IDS=

# Local browser tests only. This is ignored in production.
WAYLO_TEST_AUTH=0

# Phase 1 follow-on services. Leave unset until the corresponding feature is enabled.
OPENAI_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
